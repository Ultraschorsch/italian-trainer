# Nach /.env kopieren und anpassen
POSTGRES_USER=italian
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=italian_trainer

# Name des Headers, den Pangolin Platform SSO / euer Forward-Auth setzt.
# In der Pangolin-Konfiguration bzw. per curl-Test gegen die Resource prüfen,
# welcher Header tatsächlich ankommt (z.B. Remote-User, X-Forwarded-User).
SSO_HEADER_NAME=Remote-User

# true = ohne SSO-Header fällt die App auf einen einfachen Cookie-Profil-Picker
# zurück (praktisch für lokale Tests, bevor Pangolin vorgeschaltet ist).
ALLOW_LOCAL_PROFILE_PICKER=true
