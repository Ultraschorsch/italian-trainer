# Nach /.env kopieren und anpassen
POSTGRES_USER=italian
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=italian_trainer

# Name des Headers, den Pangolin Platform SSO / euer Forward-Auth setzt.
# In der Pangolin-Konfiguration bzw. per curl-Test gegen die Resource prüfen,
# welcher Header tatsächlich ankommt (z.B. Remote-User, X-Forwarded-User).
SSO_HEADER_NAME=Remote-User

# true = ohne SSO-Header fällt die App auf einen einfachen Cookie-Profil-Picker
# zurück (praktisch für lokale Tests, bevor Pangolin vorgeschaltet ist).
ALLOW_LOCAL_PROFILE_PICKER=true

# KI-Rückfragen (optional, leer lassen = Feature deaktiviert).
# LLM_BASE_URL erwartet die VOLLSTÄNDIGE Chat-Completions-URL, z.B.:
#   OpenWebUI (self-hosted, Standard-Empfehlung):
#     LLM_BASE_URL=http://openwebui:8080/api/chat/completions
#     (Hostname/Port an euren Dockhand-Stack-Namen bzw. die Portfreigabe anpassen;
#      falls die App im selben Docker-Netzwerk wie OpenWebUI läuft, reicht der
#      Servicename, sonst 192.168.1.184:<Port>)
#   OpenRouter (Cloud, Alternative):
#     LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_BASE_URL=
# API-Key: bei OpenWebUI unter Einstellungen -> Konto -> API-Schlüssel erzeugen.
# Bei OpenRouter der dortige API-Key. Bei OpenWebUI ohne Auth kann das leer bleiben.
LLM_API_KEY=
# Modellname exakt wie in OpenWebUI hinterlegt (z.B. "llama3.1:8b") bzw. wie
# von OpenRouter erwartet (z.B. "openai/gpt-4o-mini").
LLM_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=30
